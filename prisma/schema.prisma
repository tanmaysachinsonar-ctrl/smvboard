generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String        @id @default(cuid())
  name               String
  createdAt          DateTime      @default(now())
  stripeCustomerId   String?
  subscription       Subscription?
  users              User[]
  accounts           Account[]
  transactions       Transaction[]
  invoices           Invoice[]
  events             Event[]
  members            Member[]
  categories         Category[]
  auditLogs          AuditLog[]
  schools            School[]
  roseCampaigns      RoseCampaign[]
  roseOrders         RoseOrder[]
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  avatarUrl     String?
  role          Role        @default(MEMBER)
  passwordHash  String?
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  schoolId      String?
  school        School?     @relation(fields: [schoolId], references: [id])
  createdAt     DateTime    @default(now())
  provider      String?
  providerId    String?
  transactions  Transaction[]
  invoices      Invoice[]
  events        Event[]
  settings      UserSettings?
  roseOrders    RoseOrder[]
}

enum Role {
  OWNER
  MEMBER
  VIEWER
}

model Member {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  position  String?
  email     String?
  phone     String?
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())
}

model Account {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  type      AccountType
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  transactions Transaction[]
}

enum AccountType {
  CASH
  BANK
  GRANT
  OTHER
}

model Transaction {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  amount       Float
  currency     String   @default("EUR")
  date         DateTime
  type         TxType
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  description  String?
  receiptUrl   String?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  reconciled   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id      String @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  name    String
  kind    CategoryKind
  createdAt DateTime @default(now())
  transactions Transaction[]
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Invoice {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  number      String   @unique
  issuedTo    String
  amount      Float
  currency    String @default("EUR")
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  pdfUrl      String?
  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Event {
  id         String @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  title      String
  description String?
  start      DateTime
  end        DateTime?
  allDay     Boolean @default(false)
  location   String?
  recurrence String?
  createdById String
  createdBy  User @relation(fields: [createdById], references: [id])
  participants EventParticipant[]
  createdAt  DateTime @default(now())
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  event   Event @relation(fields: [eventId], references: [id])
  userId  String?
  name    String?
  status  ParticipantStatus @default(MAYBE)
}

enum ParticipantStatus {
  YES
  NO
  MAYBE
}

model Subscription {
  id                String @id @default(cuid())
  orgId             String @unique
  org               Organization @relation(fields: [orgId], references: [id])
  stripeSubscriptionId String
  planId            String
  status            String
  currentPeriodEnd  DateTime?
  createdAt         DateTime @default(now())
}

model AuditLog {
  id        String @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model UserSettings {
  id                    String @id @default(cuid())
  userId                String @unique
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications    Boolean @default(true)
  eventReminders        Boolean @default(true)
  financeUpdates        Boolean @default(false)
  language              String @default("de")
  timezone              String @default("Europe/Berlin")
  profileVisibility     Boolean @default(true)
  twoFactorEnabled      Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RoseOrder {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  campaignId      String?
  campaign        RoseCampaign? @relation(fields: [campaignId], references: [id])
  senderSchoolId  String
  senderSchool    School @relation("SenderOrders", fields: [senderSchoolId], references: [id])
  recipientSchoolId String
  recipientSchool School @relation("RecipientOrders", fields: [recipientSchoolId], references: [id])
  recipientName   String
  recipientClass  String?
  roseCount       Int @default(1)
  senderNote      String?
  createdById     String
  createdBy       User @relation(fields: [createdById], references: [id])
  isAnonymous     Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([recipientSchoolId, recipientName])
  @@index([orgId])
  @@index([campaignId])
  @@index([createdById])
}

model School {
  id              String @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  name            String
  accessCode      String @unique
  description     String?
  users           User[]
  sentOrders      RoseOrder[] @relation("SenderOrders")
  receivedOrders  RoseOrder[] @relation("RecipientOrders")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId])
}

model RoseCampaign {
  id          String @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  pricePerRose Float @default(1.50)
  status      RoseCampaignStatus @default(OPEN)
  orders      RoseOrder[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([status])
}

enum RoseCampaignStatus {
  PLANNED
  OPEN
  CLOSED
  ARCHIVED
}