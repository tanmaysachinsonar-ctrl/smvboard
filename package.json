    "jsonwebtoken": "^9.0.3",
    "micro": "^10.0.1",
    "next": "14.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "stripe": "^12.0.0",
    "zod": "^4.3.6"
  },
